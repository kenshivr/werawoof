{
  "name": "werawoof-frontend",
  "version": "1.1.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^2.0.10",
    "@pinia/nuxt": "^0.9.0",
    "@vercel/analytics": "^2.0.1",
    "emoji-picker-element": "^1.29.1",
    "nodemailer": "^10.0.1",
    "nuxt": "^3.21.11",
    "pinia": "^2.3.0",
    "vue": "^3.5.32",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.4.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/nodemailer": "^8.0.1",
    "@vue/test-utils": "^2.4.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.12"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": "prettier --write"
  }
}
